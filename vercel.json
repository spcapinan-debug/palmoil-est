{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "webapp/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/planning-selector-ux\\.js",
      "dest": "/webapp/planning-selector-ux.js"
    },
    {
      "src": "/(app\\.js|styles\\.css)",
      "dest": "/webapp/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/webapp/index.html"
    }
  ]
}
